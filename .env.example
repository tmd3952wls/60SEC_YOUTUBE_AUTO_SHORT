# 이 파일을 .env 로 복사한 뒤 가진 키만 채우세요.
# API 키를 하나도 채우지 않아도 무료 로컬 효과음 디렉터(local-free)와 웹 에디터가 0원으로 작동합니다!

# ==============================================================================
# 1. 기존 대본 / TTS / 메일 설정 (기존 파이프라인 호환 그대로 유지)
# ==============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

FISH_API_KEY=
TYPECAST_API_KEY=

NAVER_SMTP_USER=
NAVER_SMTP_PASS=

# ==============================================================================
# 2. 완전 자동 효과음 디렉터 & 해외쇼쇼 프리셋 (0원 무과금 모드 기본 탑재)
# ==============================================================================
AUTO_SFX_ENABLED=true
AUTO_SYNC_SUBTITLES=true

# 연출 백엔드 모드: local-free (0원 기본값) | agy-cli (0원 구독 계정) | gemini-api | auto
SFX_DIRECTOR_BACKEND=local-free

# 해외쇼쇼 강도·밀도 프리셋:
# - clean    : 깔끔형 (대사 집중 · 분당 ~10개 · -16.5dB 중심)
# - balanced : 해외쇼쇼 표준 (레퍼런스 밸런스 · 분당 ~18개 · -15.0dB 중심)
# - punchy   : 타격감 강조형 (고밀도 + 차오름 swell 라이저 빌드업 · 분당 ~28개 · -13.5dB 중심)
SFX_STYLE_PRESET=balanced

# 로컬 효과음 2,869개 폴더 경로 및 카탈로그 캐시 위치
LOCAL_SFX_DIR=C:\Users\tmd39\Desktop\효과음\효과음2869개
SFX_CATALOG_PATH=assets/sfx_catalog.json
SFX_CUESHEET_DIR=jobs/_cuesheets
SFX_CATALOG_WORKERS=6

# Gemini 멀티모달 API 키 (선택 · Cloud Billing 미연결 프로젝트 키는 Free Tier 0원 한도 보장)
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_VIDEO_MODEL=gemini-2.5-flash
GEMINI_AUDIO_BATCH_SIZE=8
GEMINI_FREE_TIER_SAFE=true

# 부족분 자동 수급 Fallback API 키 (선택 · 비워두면 로컬 2,869개 전용 모드)
SFX_LOCAL_MATCH_THRESHOLD=0.50
SFX_FALLBACK_ORDER=freesound,elevenlabs
FREESOUND_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v3

# 수동 오버라이드용 음압·간격 (비워두면 위 SFX_STYLE_PRESET 값이 자동 적용됩니다)
# SFX_DEFAULT_DB=-15.0
# SFX_MIN_DB=-18.0
# SFX_MAX_DB=-12.0
SFX_ENABLE_DUCKING=true
SFX_ANCHOR_SNAP_SEC=0.18
