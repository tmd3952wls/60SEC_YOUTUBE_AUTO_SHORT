# 이 파일을 .env 로 복사한 뒤 가진 키만 채우세요.
# 대본 자동 생성 (둘 중 하나, 없으면 수동 모드: prompt.txt 를 ChatGPT/Claude 창에 붙여넣기)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TTS (config.json 의 tts.provider 를 fish 또는 typecast 로 바꾸고 voice id 도 채우기)
FISH_API_KEY=
TYPECAST_API_KEY=

# 네이버 메일 자동 발송 (2단계 인증 후 애플리케이션 비밀번호)
NAVER_SMTP_USER=
NAVER_SMTP_PASS=
