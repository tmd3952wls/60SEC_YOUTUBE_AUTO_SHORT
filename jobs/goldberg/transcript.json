    "end": 458.82,
    "text": "Yeah."
  },
  {
    "id": 207,
    "start": 458.82,
    "end": 459.82,
    "text": "He'll take only one."
  },
  {
    "id": 208,
    "start": 459.82,
    "end": 460.82,
    "text": "You did catch that, right?"
  },
  {
    "id": 209,
    "start": 460.82,
    "end": 461.82,
    "text": "I haven't given up yet."
  },
  {
    "id": 210,
    "start": 461.82,
    "end": 467.4,
    "text": "How about we give you a $250,000 loan for 18 months,"
  },
  {
    "id": 211,
    "start": 467.4,
    "end": 471.4,
    "text": "and you give us 10% advisory shares?"
