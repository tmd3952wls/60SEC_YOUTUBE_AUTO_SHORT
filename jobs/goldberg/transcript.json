    "end": 448.4,
    "text": "Look, I am the king of royalties."
  },
  {
    "id": 202,
    "start": 448.4,
    "end": 449.4,
    "text": "Everybody knows that."
  },
  {
    "id": 203,
    "start": 449.4,
    "end": 454.82,
    "text": "$250 for 7.5%, $50 a cover until I get back $500K,"
