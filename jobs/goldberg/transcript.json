    "text": "Go!"
  },
  {
    "id": 195,
    "start": 436.16,
    "end": 437.16,
    "text": "All right?"
  },
  {
    "id": 196,
    "start": 437.16,
    "end": 441.0,
    "text": "I'm going to go down to 7.5%, but I'm going to take the $50 royalty now that royalties"
